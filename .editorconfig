# This file unifies basic coding style across different editors and
# IDEs. See https://editorconfig.org for details, most editors pick it
# up automatically, some need a small plugin.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
